# Created by ./jobradar setup. Edit by hand if you like, then run ./jobradar restart.
# Never commit this file.

# Claude API key — console.anthropic.com → API keys (prepaid credits)
ANTHROPIC_API_KEY=
SCORING_MODEL=claude-haiku-5-5
TAILORING_MODEL=claude-sonnet-5-5

# Where notifications go: telegram, email, or telegram,email
NOTIFY_CHANNELS=telegram

# Telegram — a bot you create with @BotFather; the setup finds your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email — any provider with SMTP + IMAP. Gmail: use an app password (2-step verification required)
NOTIFY_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=JobRadar

# Your time zone (reports, quiet hours), e.g. Europe/Vienna
TIMEZONE=UTC

# Optional: Hiring Cafe through Apify instead of the community MCP server
APIFY_TOKEN=
